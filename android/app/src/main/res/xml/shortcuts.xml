<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon. Each opens meksova://action/<name>, which
     src/components/NativeShortcuts.js routes once the user is signed in. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="scan"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_scan"
        android:shortcutShortLabel="@string/shortcut_scan">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.meksova.app"
            android:targetClass="com.meksova.app.MainActivity"
            android:data="meksova://action/scan" />
    </shortcut>
    <shortcut
        android:shortcutId="trip"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_trip"
        android:shortcutShortLabel="@string/shortcut_trip">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.meksova.app"
            android:targetClass="com.meksova.app.MainActivity"
            android:data="meksova://action/trip" />
    </shortcut>
    <shortcut
        android:shortcutId="add"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/shortcut_add">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.meksova.app"
            android:targetClass="com.meksova.app.MainActivity"
            android:data="meksova://action/add" />
    </shortcut>
</shortcuts>
